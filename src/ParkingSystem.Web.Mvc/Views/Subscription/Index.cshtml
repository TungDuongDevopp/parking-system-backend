@using ParkingSystem.Web.Startup

@{
    ViewBag.Title = L("Subscriptions");
    ViewBag.CurrentPageName = PageNames.Subscriptions;
}
@section scripts
{
    <script src="~/view-resources/Views/Subscription/Index.js" asp-append-version="true"></script>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>@L("Subscriptions")</h1>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                @await Html.PartialAsync("~/Views/Subscription/Index.AdvancedSearch.cshtml")
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="SubscriptionTable" class="table table-striped table-bordered table-hover w-100">
                        <thead>
                            <tr>
                                <th></th>        
                                <th>@L("CustomerName")</th>
                                <th>@L("VehicleType")</th>
                                <th>@L("Duration")</th> 
                                <th>@L("Price")</th>
                                <th>@L("StartTime")</th>
                                <th>@L("EndTime")</th>
                                <th>@L("Status")</th>     
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>



