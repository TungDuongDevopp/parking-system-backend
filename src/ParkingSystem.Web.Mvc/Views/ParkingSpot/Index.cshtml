@using ParkingSystem.Web.Startup
@using ParkingSystem.Authorization
@using ParkingSystem.Entities.Enums
@{
    ViewBag.Title = L("ParkingSpots");
    ViewBag.CurrentPageName = PageNames.ParkingSpots;
}
@section scripts
{
    <script src="~/view-resources/Views/ParkingSpot/Index.js" asp-append-version="true"></script>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>@L("ParkingSpots")</h1>
            </div>
            <div class="col-sm-6">
                @if (IsGranted(PermissionNames.Pages_ParkingSpots))
                {
                    <a href="javascript:;" data-bs-toggle="modal" data-bs-target="#ParkingSpotCreateModal" class="btn bg-blue float-sm-right">
                        <i class="fa fa-plus-square"></i> @L("Create")
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                @await Html.PartialAsync("~/Views/ParkingSpot/Index.AdvancedSearch.cshtml")
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="ParkingSpotTable" class="table table-striped table-bordered table-hover w-100">
                        <thead>
                            <tr>
                                <th></th>
                                <th>@L("SpotCode")</th>
                                <th>@L("ParkingAreaId")</th>
                                <th>@L("ParkingAreaCode")</th>
                                <th>@L("ParkingAreaName")</th>
                                <th>@L("Status")</th>
                                <th>@L("CreationTime")</th>
                                <th style="width: 200px">@L("Actions")</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("~/Views/ParkingSpot/_CreateModal.cshtml")

<div class="modal fade" id="ParkingSpotEditModal" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content"></div>
    </div>
</div>

<div class="modal fade" id="ParkingSpotStatusModal" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <form id="ParkingSpotStatusForm">
                <input type="hidden" name="Id" id="ParkingSpotStatus_Id" />
                <div class="modal-header">
                    <h5 class="modal-title">@L("ChangeStatus")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">@L("SpotCode"): <span id="ParkingSpotStatus_Code" class="text-primary"></span></label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L("Status")</label>
                        <select class="form-control" name="Status" id="ParkingSpotStatus_Select">
                            <option value="@((int)ParkingSpotStatus.Available)">@L("Available")</option>
                            <option value="@((int)ParkingSpotStatus.Unavailable)">@L("Unavailable")</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L("Cancel")</button>
                    <button type="submit" class="btn btn-primary">@L("Save")</button>
                </div>
            </form>
        </div>
    </div>
</div>
