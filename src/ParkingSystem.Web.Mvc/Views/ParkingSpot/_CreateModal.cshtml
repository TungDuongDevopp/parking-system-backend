@using ParkingSystem.Web.Models.Common.Modals
@using ParkingSystem.Entities.Enums

<div class="modal fade" id="ParkingSpotCreateModal" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form name="parkingSpotCreateForm" role="form" class="form-horizontal">
                @await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel(L("CreateNewParkingSpot")))
                <div class="modal-body">
                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("ParkingCode")</label>
                        <div class="col-md-9">
                            <input type="text" class="form-control" name="ParkingCode" maxlength="30" placeholder="@L("ParkingCode")" />
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("Name")</label>
                        <div class="col-md-9">
                            <input type="text" class="form-control" name="Name" maxlength="30" placeholder="@L("Name")" />
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("VehicleType")</label>
                        <div class="col-md-9">
                            <select class="form-control" name="VehicleType">
                                <option value="">-- @L("SelectType") --</option>
                                <option value="@((int)VehicleType.Bicycle)">@L("Bicycle")</option>
                                <option value="@((int)VehicleType.ElectricBicycle)">@L("ElectricBicycle")</option>
                                <option value="@((int)VehicleType.Motorcycle)">@L("Motorcycle")</option>
                                <option value="@((int)VehicleType.ElectricMotorcycle)">@L("ElectricMotorcycle")</option>
                                <option value="@((int)VehicleType.Car)">@L("Car")</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("Capacity")</label>
                        <div class="col-md-9">
                            <input type="number" class="form-control" name="Capacity" min="0" placeholder="@L("Capacity")" />
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("ParkingMode")</label>
                        <div class="col-md-9">
                            <select class="form-control" name="ParkingMode">
                                <option value="">-- @L("SelectMode") --</option>
                                <option value="@((int)ParkingMode.individualSpot)">@L("individualSpot")</option>
                                <option value="@((int)ParkingMode.capacityBase)">@L("capacityBase")</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("Location")</label>
                        <div class="col-md-9">
                            <input type="text" class="form-control" name="Location" maxlength="255" placeholder="@L("Location")" />
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("Description")</label>
                        <div class="col-md-9">
                            <textarea class="form-control" name="Description" maxlength="255" placeholder="@L("Description")"></textarea>
                        </div>
                    </div>
                </div>
                @await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
            </form>
        </div>
    </div>
</div>
