@using ParkingSystem.Entities.Enums

<form id="ParkingSpotSearchForm" class="form-horizontal">
    <div class="row g-2 align-items-center">
        <!-- Search -->
        <div class="col-md-3">
            <div class="input-group">
                <input type="text" name="Keyword" class="form-control txt-search" placeholder="@L("SearchWithThreeDot")" />
                <button type="button" class="btn bg-blue btn-search" title="@L("Search")">
                    <span class="fas fa-search" aria-hidden="true"></span>
                </button>
            </div>
        </div>

        <!-- Parking Spot Status -->
        <div class="col-md-2">
            <select name="Status" class="form-control vehicle-type-filter">
                <option value="">@L("All") @L("Status")</option>
                <option value="@((int)ParkingSpotStatus.Available)">@L("Available")</option>
                <option value="@((int)ParkingSpotStatus.Occupied)">@L("Occupied")</option>
                <option value="@((int)ParkingSpotStatus.Reserved)">@L("Reserved")</option>
                <option value="@((int)ParkingSpotStatus.Unavailable)">@L("Unavailable")</option>
            </select>
        </div>

      
        <!-- Parking Area Id -->
        <div class="col-md-3 d-flex gap-1">
            <input type="number" name="ParkingAreaId" class="form-control" title="@L("ParkingAreaId")" min="1" placeholder="@L("ParkingAreaId")" />
        </div>

        <!-- Actions -->
        <div class="col-md-4 d-flex gap-1">
            <button type="button" class="btn btn-primary btn-search flex-grow-1" title="@L("Filter")">
                <i class="fas fa-filter"></i> @L("Filter")
            </button>
            <button type="button" class="btn btn-outline-secondary btn-clear-search" title="@L("Clear")">
                <i class="fas fa-undo"></i>
            </button>
        </div>
    </div>
</form>

