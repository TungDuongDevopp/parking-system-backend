@using ParkingSystem.Entities.Enums
@model ParkingSystem.Web.Models.Home.HomeViewModel

<!-- ADMIN OVERVIEW STAT CARDS (ROW 1: Core Parking Operations) -->
<div class="row">
    <!-- 1. Total Spots & Available -->
    <div class="col-12 col-sm-6 col-md-3">
        <div class="info-box shadow-sm border-0" style="border-radius: 10px;">
            <span class="info-box-icon bg-info elevation-1" style="border-radius: 10px;"><i class="fas fa-parking"></i></span>
            <div class="info-box-content">
                <span class="info-box-text text-muted">Tổng Chỗ Đỗ</span>
                <span class="info-box-number text-dark" style="font-size: 1.5rem;">@Model.AdminStats.TotalParkingSpots</span>
                <div class="progress" style="height: 4px;">
                    @{
                        var availPercent = Model.AdminStats.TotalParkingSpots > 0 
                            ? (Model.AdminStats.AvailableSpots * 100 / Model.AdminStats.TotalParkingSpots) 
                            : 0;
                    }
                    <div class="progress-bar bg-info" style="width: @availPercent%"></div>
                </div>
                <span class="progress-description text-muted small">
                    Trống: <strong>@Model.AdminStats.AvailableSpots</strong> / @Model.AdminStats.TotalParkingSpots
                </span>
            </div>
        </div>
    </div>

    <!-- 2. Occupied Spots -->
    <div class="col-12 col-sm-6 col-md-3">
        <div class="info-box mb-3 shadow-sm border-0" style="border-radius: 10px;">
            <span class="info-box-icon bg-warning text-white elevation-1" style="border-radius: 10px;"><i class="fas fa-car-side"></i></span>
            <div class="info-box-content">
                <span class="info-box-text text-muted">Xe Đang Đỗ</span>
                <span class="info-box-number text-dark" style="font-size: 1.5rem;">@Model.AdminStats.OccupiedSpots</span>
                <div class="progress" style="height: 4px;">
                    @{
                        var occPercent = Model.AdminStats.TotalParkingSpots > 0 
                            ? (Model.AdminStats.OccupiedSpots * 100 / Model.AdminStats.TotalParkingSpots) 
                            : 0;
                    }
                    <div class="progress-bar bg-warning" style="width: @occPercent%"></div>
                </div>
                <span class="progress-description text-muted small">
                    Tỉ lệ đỗ: <strong>@occPercent%</strong>
                </span>
            </div>
        </div>
    </div>

    <!-- 3. Reservations -->
    <div class="col-12 col-sm-6 col-md-3">
        <div class="info-box mb-3 shadow-sm border-0" style="border-radius: 10px;">
            <span class="info-box-icon bg-success elevation-1" style="border-radius: 10px;"><i class="fas fa-calendar-check"></i></span>
            <div class="info-box-content">
                <span class="info-box-text text-muted">Đang Giữ Chỗ (Đặt)</span>
                <span class="info-box-number text-dark" style="font-size: 1.5rem;">@Model.AdminStats.ReservedSpots</span>
                <span class="progress-description text-muted small">
                    Tổng đơn đặt: <strong>@Model.AdminStats.TotalReservations</strong>
                </span>
            </div>
        </div>
    </div>

    <!-- 4. Parking Areas -->
    <div class="col-12 col-sm-6 col-md-3">
        <div class="info-box mb-3 shadow-sm border-0" style="border-radius: 10px;">
            <span class="info-box-icon bg-primary elevation-1" style="border-radius: 10px;"><i class="fas fa-map-marked-alt"></i></span>
            <div class="info-box-content">
                <span class="info-box-text text-muted">Bãi Đỗ Xe</span>
                <span class="info-box-number text-dark" style="font-size: 1.5rem;">@Model.AdminStats.TotalParkingAreas</span>
                <span class="progress-description text-muted small">
                    Đang hoạt động: <strong>@Model.AdminStats.ActiveParkingAreas</strong>
                </span>
            </div>
        </div>
    </div>
</div>

<!-- ADMIN SECONDARY METRICS (ROW 2: Customers, Vehicles, Subscriptions, Staff) -->
<div class="row mb-3">
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0 text-center p-3" style="border-radius: 10px;">
            <div class="text-secondary mb-1"><i class="fas fa-users fa-2x"></i></div>
            <h4 class="font-weight-bold mb-0">@Model.AdminStats.TotalCustomers</h4>
            <small class="text-muted">Khách Hàng</small>
            <a href="@Url.Action("Index", "Customer")" class="small mt-2 text-primary font-weight-bold">Quản lý <i class="fas fa-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0 text-center p-3" style="border-radius: 10px;">
            <div class="text-info mb-1"><i class="fas fa-car fa-2x"></i></div>
            <h4 class="font-weight-bold mb-0">@Model.AdminStats.TotalVehicles</h4>
            <small class="text-muted">Phương Tiện</small>
            <a href="@Url.Action("Index", "Vehicle")" class="small mt-2 text-info font-weight-bold">Quản lý <i class="fas fa-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0 text-center p-3" style="border-radius: 10px;">
            <div class="text-success mb-1"><i class="fas fa-ticket-alt fa-2x"></i></div>
            <h4 class="font-weight-bold mb-0">@Model.AdminStats.TotalSubscriptions</h4>
            <small class="text-muted">Đăng Ký Vé Tháng</small>
            <a href="@Url.Action("Index", "Subscription")" class="small mt-2 text-success font-weight-bold">Quản lý <i class="fas fa-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0 text-center p-3" style="border-radius: 10px;">
            <div class="text-purple mb-1"><i class="fas fa-user-tie fa-2x" style="color: #6f42c1;"></i></div>
            <h4 class="font-weight-bold mb-0">@Model.AdminStats.TotalStaffs</h4>
            <small class="text-muted">Nhân Viên Bãi Xe</small>
            <a href="@Url.Action("Index", "Staff")" class="small mt-2 font-weight-bold" style="color: #6f42c1;">Quản lý <i class="fas fa-arrow-right"></i></a>
        </div>
    </div>
</div>

<!-- DETAILED TABLES & OCCUPANCY MONITOR -->
<div class="row">
    <!-- Parking Areas Occupancy -->
    <div class="col-lg-7 mb-4">
        <div class="card shadow-sm border-0 h-100" style="border-radius: 12px;">
            <div class="card-header bg-white border-bottom-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                <h5 class="card-title font-weight-bold mb-0 text-dark">
                    <i class="fas fa-chart-pie text-primary mr-2"></i> Tình Trạng Lấp Đầy Từng Bãi Xe
                </h5>
                <a href="@Url.Action("Index", "ParkingArea")" class="btn btn-sm btn-outline-primary">
                    Xem tất cả
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Mã Bãi</th>
                                <th>Tên Bãi</th>
                                <th>Loại Xe</th>
                                <th>Sức Chứa</th>
                                <th>Tỉ Lệ Lấp Đầy</th>
                                <th>Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AdminStats.ParkingAreas != null && Model.AdminStats.ParkingAreas.Any())
                            {
                                foreach (var area in Model.AdminStats.ParkingAreas)
                                {
                                    var areaOccPercent = area.Capacity > 0 ? (area.CurrentOccupancy * 100 / area.Capacity) : 0;
                                    var progressColor = areaOccPercent >= 90 ? "bg-danger" : (areaOccPercent >= 70 ? "bg-warning" : "bg-success");
                                    <tr>
                                        <td><strong>@area.ParkingCode</strong></td>
                                        <td>@area.Name</td>
                                        <td>
                                            <span class="badge badge-light">@area.VehicleTypeName</span>
                                        </td>
                                        <td>@area.Capacity</td>
                                        <td style="min-width: 140px;">
                                            <div class="d-flex align-items-center">
                                                <div class="progress flex-grow-1 mr-2" style="height: 6px;">
                                                    <div class="progress-bar @progressColor" style="width: @areaOccPercent%"></div>
                                                </div>
                                                <span class="small font-weight-bold">@areaOccPercent%</span>
                                            </div>
                                            <small class="text-muted">@area.CurrentOccupancy / @area.Capacity xe</small>
                                        </td>
                                        <td>
                                            @if (area.Status == ParkingAreaStatus.Active)
                                            {
                                                <span class="badge badge-success">Hoạt động</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">Tạm đóng</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        <i class="fas fa-inbox fa-2x mb-2 d-block"></i> Chưa có dữ liệu bãi đỗ xe
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Reservations -->
    <div class="col-lg-5 mb-4">
        <div class="card shadow-sm border-0 h-100" style="border-radius: 12px;">
            <div class="card-header bg-white border-bottom-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                <h5 class="card-title font-weight-bold mb-0 text-dark">
                    <i class="fas fa-clock text-info mr-2"></i> Đặt Chỗ Mới Nhất
                </h5>
                <a href="@Url.Action("Index", "Reservation")" class="btn btn-sm btn-outline-info">
                    Xem tất cả
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Mã</th>
                                <th>Khách Hàng</th>
                                <th>Thời Gian Đặt</th>
                                <th>Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AdminStats.RecentReservations != null && Model.AdminStats.RecentReservations.Any())
                            {
                                foreach (var r in Model.AdminStats.RecentReservations.Take(8))
                                {
                                    <tr>
                                        <td><strong>#@r.Id</strong></td>
                                        <td>@(string.IsNullOrEmpty(r.CustomerName) ? "Khách #" + r.CustomerId : r.CustomerName)</td>
                                        <td class="small">@r.ReservedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (r.Status == ReservationStatus.Reserved)
                                            {
                                                <span class="badge badge-warning text-white">Đang đặt</span>
                                            }
                                            else if (r.Status == ReservationStatus.Completed)
                                            {
                                                <span class="badge badge-success">Hoàn thành</span>
                                            }
                                            else if (r.Status == ReservationStatus.Cancelled)
                                            {
                                                <span class="badge badge-secondary">Đã hủy</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-light">@r.Status.ToString()</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">
                                        <i class="fas fa-calendar-times fa-2x mb-2 d-block"></i> Chưa có lượt đặt chỗ nào
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
