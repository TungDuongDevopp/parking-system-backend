@using ParkingSystem.Web.Models.Home
@using ParkingSystem.Web.Startup
@model ParkingSystem.Web.Models.Home.HomeViewModel

@{
    ViewBag.Title = Model.Role == UserHomeRole.Admin 
        ? "Admin Dashboard - Hệ Thống Bãi Đỗ Xe" 
        : (Model.Role == UserHomeRole.Staff 
            ? "Trực Ca Bãi Xe - Nhân Viên" 
            : "Trang Chủ - Đặt Chỗ Đỗ Xe Thông Minh");
    ViewBag.CurrentPageName = PageNames.Home;
}

<style>
    .hover-shadow {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-shadow:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1.2rem rgba(0,0,0,.12) !important;
    }
    .role-badge-btn {
        border-radius: 20px;
        font-size: 0.85rem;
        padding: 4px 14px;
        font-weight: 600;
    }
</style>

<!-- CONTENT HEADER & ROLE SWITCHER (FOR ADMIN) -->
<div class="content-header pb-2">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark font-weight-bold" style="font-size: 1.6rem;">
                    @if (Model.Role == UserHomeRole.Admin)
                    {
                        <i class="fas fa-chart-line text-primary mr-2"></i>
                        <span>Tổng Quan Quản Trị Hệ Thống</span>
                    }
                    else if (Model.Role == UserHomeRole.Staff)
                    {
                        <i class="fas fa-tasks text-warning mr-2"></i>
                        <span>Bảng Tác Nghiệp Đỗ Xe</span>
                    }
                    else
                    {
                        <i class="fas fa-parking text-primary mr-2"></i>
                        <span>Cổng Dịch Vụ Khách Hàng</span>
                    }
                </h1>
            </div>

            <!-- Role View Switcher for Admin testing / previewing -->
            @if (Model.CanSwitchRoleView)
            {
                <div class="col-sm-6 text-sm-right mt-2 mt-sm-0">
                    <span class="text-muted small mr-2">Xem giao diện theo vai trò:</span>
                    <div class="btn-group shadow-sm" role="group">
                        <a href="@Url.Action("Index", "Home", new { role = "admin" })" 
                           class="btn btn-sm @(Model.Role == UserHomeRole.Admin ? "btn-primary font-weight-bold" : "btn-outline-primary")">
                            <i class="fas fa-user-shield mr-1"></i> Admin
                        </a>
                        <a href="@Url.Action("Index", "Home", new { role = "staff" })" 
                           class="btn btn-sm @(Model.Role == UserHomeRole.Staff ? "btn-warning text-dark font-weight-bold" : "btn-outline-secondary")">
                            <i class="fas fa-user-tie mr-1"></i> Staff
                        </a>
                        <a href="@Url.Action("Index", "Home", new { role = "customer" })" 
                           class="btn btn-sm @(Model.Role == UserHomeRole.Customer ? "btn-success font-weight-bold" : "btn-outline-secondary")">
                            <i class="fas fa-user mr-1"></i> Customer
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- MAIN CONTENT -->
<section class="content">
    <div class="container-fluid">
        @if (Model.Role == UserHomeRole.Customer)
        {
            @await Html.PartialAsync("_CustomerHome", Model)
        }
        else if (Model.Role == UserHomeRole.Staff)
        {
            @await Html.PartialAsync("_StaffHome", Model)
        }
        else
        {
            @await Html.PartialAsync("_AdminHome", Model)
        }
    </div>
</section>
