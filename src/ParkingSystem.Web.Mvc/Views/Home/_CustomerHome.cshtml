@model ParkingSystem.Web.Models.Home.HomeViewModel

<!-- CUSTOMER HERO BANNER -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card overflow-hidden shadow-sm border-0" style="border-radius: 16px; background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); color: white;">
            <div class="row no-gutters g-0 align-items-center">
                <div class="col-lg-7 p-4 p-md-5">
                    <span class="badge badge-light px-3 py-2 text-primary font-weight-bold mb-3" style="font-size: 0.9rem; border-radius: 20px;">
                        <i class="fas fa-shield-alt mr-1"></i> Hệ Thống Đỗ Xe Thông Minh
                    </span>
                    <h1 class="display-5 font-weight-bold mb-3" style="font-size: 2.2rem; line-height: 1.2;">
                        Chào mừng, @Model.CustomerInfo.CustomerName!
                    </h1>
                    <p class="lead mb-4 text-light" style="font-size: 1.1rem; opacity: 0.95;">
                        Trải nghiệm giải pháp gửi xe hiện đại, an toàn và tiện lợi. Đặt trước chỗ đỗ xe dễ dàng, không lo hết chỗ giờ cao điểm, quản lý vé tháng linh hoạt và thanh toán nhanh chóng.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="@Url.Action("MyReservations", "Reservation")" class="btn btn-warning btn-lg font-weight-bold mr-2 mb-2 shadow-sm text-dark px-4" style="border-radius: 10px;">
                            <i class="fas fa-calendar-check mr-2"></i> Đặt Chỗ Đỗ Xe Ngay
                        </a>
                        <a href="@Url.Action("MySubscription", "Subscription")" class="btn btn-outline-light btn-lg font-weight-bold mb-2 px-4" style="border-radius: 10px;">
                            <i class="fas fa-ticket-alt mr-2"></i> Mua Gói Vé Tháng
                        </a>
                    </div>
                </div>
                <div class="col-lg-5 p-3 text-center d-none d-lg-block">
                    <img src="~/img/parking_hero.jpg" alt="Smart Parking Hub" class="img-fluid rounded shadow" style="max-height: 280px; object-fit: cover; width: 95%; border: 3px solid rgba(255,255,255,0.2);">
                </div>
            </div>
        </div>
    </div>
</div>

<!-- QUICK ACTION SERVICES -->
<div class="row mb-4">
    <div class="col-12 mb-2">
        <h4 class="font-weight-bold text-dark">
            <i class="fas fa-th-large text-primary mr-2"></i> Dịch Vụ Dành Cho Bạn
        </h4>
        <p class="text-muted">Chọn dịch vụ nhanh chóng để bắt đầu trải nghiệm</p>
    </div>

    <!-- 1. Đặt chỗ đỗ xe -->
    <div class="col-md-6 col-xl-3 mb-3">
        <div class="card h-100 shadow-sm border-0 hover-shadow transition-all" style="border-radius: 12px; border-top: 4px solid #007bff !important;">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mr-3" style="width: 50px; height: 50px; min-width: 50px;">
                        <i class="fas fa-calendar-alt fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="card-title font-weight-bold mb-0">Đặt Chỗ Đỗ Xe</h5>
                        <span class="badge badge-primary">Nhanh chóng</span>
                    </div>
                </div>
                <p class="card-text text-muted flex-grow-1">
                    Chủ động giữ trước vị trí đỗ tại các bãi xe theo khung giờ mong muốn. Đảm bảo có chỗ sẵn sàng ngay khi bạn đến.
                </p>
                <a href="@Url.Action("MyReservations", "Reservation")" class="btn btn-outline-primary btn-block font-weight-bold mt-2">
                    <i class="fas fa-calendar-plus mr-1"></i> Đặt Chỗ Ngay
                </a>
            </div>
        </div>
    </div>

    <!-- 2. Mua gói vé tháng -->
    <div class="col-md-6 col-xl-3 mb-3">
        <div class="card h-100 shadow-sm border-0 hover-shadow transition-all" style="border-radius: 12px; border-top: 4px solid #28a745 !important;">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center mr-3" style="width: 50px; height: 50px; min-width: 50px;">
                        <i class="fas fa-ticket-alt fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="card-title font-weight-bold mb-0">Gói Vé Tháng</h5>
                        <span class="badge badge-success">Tiết kiệm 30%</span>
                    </div>
                </div>
                <p class="card-text text-muted flex-grow-1">
                    Đăng ký vé tháng linh hoạt cho ô tô hoặc xe máy. Tối ưu chi phí gửi xe thường xuyên và ra vào không giới hạn.
                </p>
                <a href="@Url.Action("MySubscription", "Subscription")" class="btn btn-outline-success btn-block font-weight-bold mt-2">
                    <i class="fas fa-shopping-cart mr-1"></i> Mua Gói Cước
                </a>
            </div>
        </div>
    </div>

    <!-- 3. Quản lý phương tiện -->
    <div class="col-md-6 col-xl-3 mb-3">
        <div class="card h-100 shadow-sm border-0 hover-shadow transition-all" style="border-radius: 12px; border-top: 4px solid #fd7e14 !important;">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-warning text-white rounded-circle d-flex align-items-center justify-content-center mr-3" style="width: 50px; height: 50px; min-width: 50px;">
                        <i class="fas fa-car fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="card-title font-weight-bold mb-0">Xe Của Tôi</h5>
                        <span class="badge badge-warning text-white">Biển số xe</span>
                    </div>
                </div>
                <p class="card-text text-muted flex-grow-1">
                    Đăng ký và cập nhật danh sách xe ô tô, xe máy của bạn để hệ thống camera tự động nhận diện tại cổng vào/ra.
                </p>
                <a href="@Url.Action("Index", "Vehicle")" class="btn btn-outline-warning btn-block font-weight-bold mt-2 text-dark">
                    <i class="fas fa-car-side mr-1"></i> Quản Lý Xe
                </a>
            </div>
        </div>
    </div>

    <!-- 4. Hồ sơ cá nhân -->
    <div class="col-md-6 col-xl-3 mb-3">
        <div class="card h-100 shadow-sm border-0 hover-shadow transition-all" style="border-radius: 12px; border-top: 4px solid #17a2b8 !important;">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center mr-3" style="width: 50px; height: 50px; min-width: 50px;">
                        <i class="fas fa-user-circle fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="card-title font-weight-bold mb-0">Hồ Sơ Cá Nhân</h5>
                        <span class="badge badge-info">Thông tin</span>
                    </div>
                </div>
                <p class="card-text text-muted flex-grow-1">
                    Xem và cập nhật số điện thoại, email liên lạc để nhận các thông báo nhắc nhở đặt chỗ và biên lai thanh toán.
                </p>
                <a href="@Url.Action("Profile", "Customer")" class="btn btn-outline-info btn-block font-weight-bold mt-2">
                    <i class="fas fa-id-card mr-1"></i> Xem Hồ Sơ
                </a>
            </div>
        </div>
    </div>
</div>

<!-- HOW IT WORKS & AMENITIES -->
<div class="row">
    <!-- Quy trình 4 bước -->
    <div class="col-lg-8 mb-4">
        <div class="card shadow-sm border-0 h-100" style="border-radius: 12px;">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h5 class="font-weight-bold text-dark mb-1">
                    <i class="fas fa-route text-success mr-2"></i> Quy Trình Gửi Xe 4 Bước Dễ Dàng
                </h5>
                <p class="text-muted small">Hướng dẫn cách thức sử dụng bãi xe thông minh</p>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-6 col-md-3 mb-3">
                        <div class="p-3 rounded bg-light h-100">
                            <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 44px; height: 44px;">
                                <strong>1</strong>
                            </div>
                            <h6 class="font-weight-bold mb-1">Đặt Chỗ Trước</h6>
                            <p class="text-muted small mb-0">Chọn bãi đỗ & khung giờ trên ứng dụng</p>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <div class="p-3 rounded bg-light h-100">
                            <div class="bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 44px; height: 44px;">
                                <strong>2</strong>
                            </div>
                            <h6 class="font-weight-bold mb-1">Quét Biển Số</h6>
                            <p class="text-muted small mb-0">Camera AI tự động nhận diện và mở barrier</p>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <div class="p-3 rounded bg-light h-100">
                            <div class="bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 44px; height: 44px;">
                                <strong>3</strong>
                            </div>
                            <h6 class="font-weight-bold mb-1">Đỗ Xe Vào Vị Trí</h6>
                            <p class="text-muted small mb-0">Đỗ đúng ô theo đèn LED và chỉ dẫn màn hình</p>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <div class="p-3 rounded bg-light h-100">
                            <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 44px; height: 44px;">
                                <strong>4</strong>
                            </div>
                            <h6 class="font-weight-bold mb-1">Rời Bãi Nhanh</h6>
                            <p class="text-muted small mb-0">Thanh toán tự động hoặc quét mã QR ra bãi</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tiện ích & Hotline hỗ trợ -->
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm border-0 h-100" style="border-radius: 12px;">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h5 class="font-weight-bold text-dark mb-1">
                    <i class="fas fa-shield-alt text-primary mr-2"></i> Tiêu Chuẩn Bãi Xe
                </h5>
                <p class="text-muted small">Cam kết an toàn và chất lượng dịch vụ</p>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-4">
                    <li class="d-flex align-items-center mb-3">
                        <i class="fas fa-video text-success mr-3 fa-lg"></i>
                        <div>
                            <strong>Camera giám sát 24/7</strong>
                            <div class="text-muted small">Ghi hình liên tục toàn bộ khu vực</div>
                        </div>
                    </li>
                    <li class="d-flex align-items-center mb-3">
                        <i class="fas fa-fire-extinguisher text-danger mr-3 fa-lg"></i>
                        <div>
                            <strong>Hệ thống PCCC tự động</strong>
                            <div class="text-muted small">Đạt tiêu chuẩn an toàn cháy nổ cao nhất</div>
                        </div>
                    </li>
                    <li class="d-flex align-items-center mb-3">
                        <i class="fas fa-bolt text-warning mr-3 fa-lg"></i>
                        <div>
                            <strong>Trạm sạc xe điện thông minh</strong>
                            <div class="text-muted small">Hỗ trợ các dòng xe ô tô điện hiện đại</div>
                        </div>
                    </li>
                </ul>

                <div class="p-3 rounded bg-light border text-center">
                    <small class="text-muted d-block mb-1">Cần hỗ trợ hoặc sự cố tại bãi?</small>
                    <a href="tel:19001234" class="font-weight-bold text-danger h5 text-decoration-none">
                        <i class="fas fa-phone-alt mr-1"></i> Hotline: 1900 1234
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
