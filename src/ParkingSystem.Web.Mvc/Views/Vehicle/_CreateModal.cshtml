@using ParkingSystem.Web.Models.Common.Modals
@using ParkingSystem.Entities.Enums

<div class="modal fade" id="VehicleCreateModal" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form name="vehicleCreateForm" role="form" class="form-horizontal">
                @await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel(L("CreateNewVehicle")))
                <div class="modal-body">
                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("VehicleType")</label>
                        <div class="col-md-9">
                            <select class="form-control" name="VehicleType">
                                <option value="">-- @L("SelectType") --</option>
                                <option value="@((int)VehicleType.Bicycle)">@L("Bicycle")</option>
                                <option value="@((int)VehicleType.ElectricBicycle)">@L("ElectricBicycle")</option>
                                <option value="@((int)VehicleType.Motorcycle)">@L("Motorcycle")</option>
                                <option value="@((int)VehicleType.ElectricMotorcycle)">@L("ElectricMotorcycle")</option>
                                <option value="@((int)VehicleType.Car)">@L("Car")</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("LicensePlate")</label>
                        <div class="col-md-9">
                            <input type="text" class="form-control" name="LicensePlate" maxlength="30" placeholder="@L("LicensePlate")">
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("Brand")</label>
                        <div class="col-md-9">
                            <input type="text" class="form-control" name="Brand" maxlength="255" placeholder="@L("Brand")">
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("Color")</label>
                        <div class="col-md-9">
                            <input type="text" class="form-control" name="Color" maxlength="255" placeholder="@L("Color")">
                        </div>
                    </div>
                </div>
                @await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
            </form>
        </div>
    </div>
</div>