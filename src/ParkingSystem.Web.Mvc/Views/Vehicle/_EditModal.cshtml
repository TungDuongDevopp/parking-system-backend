@using ParkingSystem.Web.Models.Common.Modals
@using ParkingSystem.Web.Models.Vehicle
@using ParkingSystem.Entities.Enums
@model EditVehicleViewModel
@{
    Layout = null;
}
@await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel(L("EditVehicle")))
<form name="vehicleEditForm" role="form" class="form-horizontal">
    <input type="hidden" name="Id" value="@Model.Vehicle.Id" />
    <div class="modal-body">
        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">@L("VehicleType")</label>
            <div class="col-md-9">
                <select class="form-control" name="VehicleType">
                    <option value="@((int)VehicleType.Bicycle)" selected="@(Model.Vehicle.VehicleType == VehicleType.Bicycle)">@L("Bicycle")</option>
                    <option value="@((int)VehicleType.ElectricBicycle)" selected="@(Model.Vehicle.VehicleType == VehicleType.ElectricBicycle)">@L("ElectricBicycle")</option>
                    <option value="@((int)VehicleType.Motorcycle)" selected="@(Model.Vehicle.VehicleType == VehicleType.Motorcycle)">@L("Motorcycle")</option>
                    <option value="@((int)VehicleType.ElectricMotorcycle)" selected="@(Model.Vehicle.VehicleType == VehicleType.ElectricMotorcycle)">@L("ElectricMotorcycle")</option>
                    <option value="@((int)VehicleType.Car)" selected="@(Model.Vehicle.VehicleType == VehicleType.Car)">@L("Car")</option>
                </select>
            </div>
        </div>
        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">@L("LicensePlate")</label>
            <div class="col-md-9">
                <input type="text" class="form-control" name="LicensePlate" value="@Model.Vehicle.LicensePlate" maxlength="30">
            </div>
        </div>
        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">@L("Brand")</label>
            <div class="col-md-9">
                <input type="text" class="form-control" name="Brand" value="@Model.Vehicle.Brand" maxlength="255">
            </div>
        </div>
        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">@L("Color")</label>
            <div class="col-md-9">
                <input type="text" class="form-control" name="Color" value="@Model.Vehicle.Color" maxlength="255">
            </div>
        </div>
    </div>
    @await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
</form>
<script src="~/view-resources/Views/Vehicle/_EditModal.js" asp-append-version="true"></script>
