@using ParkingSystem.Entities.Enums

<form id="ParkingAreasSearchForm" class="form-horizontal">
    <div class="row g-2 align-items-center">
        <!-- Search -->
        <div class="col-md-3">
            <div class="input-group">
                <input
                    type="text"
                    name="Keyword"
                    class="form-control txt-search"
                    placeholder="@L("SearchWithThreeDot")" />
                <button type="button" class="btn bg-blue btn-search" title="@L("Search")">
                    <span class="fas fa-search" aria-hidden="true"></span>
                </button>
            </div>
        </div>

        <!-- Vehicle Type -->
        <div class="col-md-2">
            <select name="VehicleType" class="form-control vehicle-type-filter">
                <option value="">@L("All") @L("Type")</option>
                <option value="@((int)VehicleType.Bicycle)">@L("Bicycle")</option>
                <option value="@((int)VehicleType.ElectricBicycle)">@L("ElectricBicycle")</option>
                <option value="@((int)VehicleType.Motorcycle)">@L("Motorcycle")</option>
                <option value="@((int)VehicleType.ElectricMotorcycle)">@L("ElectricMotorcycle")</option>
                <option value="@((int)VehicleType.Car)">@L("Car")</option>
            </select>
        </div>

        <!-- Parking Mode -->
        <div class="col-md-2">
            <select name="ParkingMode" class="form-control parkingmode-type-filter">
                <option value="">@L("All") @L("ParkingMode")</option>
                <option value="@((int)ParkingMode.individualSpot)">@L("individualSpot")</option>
                <option value="@((int)ParkingMode.capacityBase)">@L("capacityBase")</option>
            </select>
        </div>

        <!-- Status -->
        <div class="col-md-2">
            <select name="Status" class="form-control status-type-filter">
                <option value="">@L("All") @L("ParkingAreaStatus")</option>
                <option value="@((int)ParkingAreaStatus.Inactive)">@L("Inactive")</option>
                <option value="@((int)ParkingAreaStatus.Active)">@L("Active")</option>
            </select>
        </div>

        <!-- Capacity -->
        <div class="col-md-2 d-flex gap-1">
            <input
                type="number"
                name="CapacityFrom"
                class="form-control"
                title="@L("CapacityFrom")"
                min="0"
                placeholder="@L("From")" />
            <input
                type="number"
                name="CapacityTo"
                class="form-control"
                min="0"
                title="@L("CapacityTo")"
                placeholder="@L("To")" />
        </div>

        <!-- Actions -->
        <div class="col-md-1 d-flex gap-1">
            <button type="button" class="btn btn-primary btn-search" title="@L("Filter")">
                <i class="fas fa-filter"></i>
            </button>
            <button type="button" class="btn btn-outline-secondary btn-clear-search" title="@L("Clear")">
                <i class="fas fa-undo"></i>
            </button>
        </div>
    </div>
</form>
