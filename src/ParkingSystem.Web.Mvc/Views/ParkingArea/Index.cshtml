@using ParkingSystem.Web.Startup
@using ParkingSystem.Authorization
@using ParkingSystem.Entities.Enums
@{
    ViewBag.Title = L("ParkingAreas");
    ViewBag.CurrentPageName = PageNames.ParkingAreas;
}
@section scripts
{
    <script src="~/view-resources/Views/ParkingArea/Index.js" asp-append-version="true"></script>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>@L("ParkingAreas")</h1>
            </div>
            <div class="col-sm-6">
                @if (IsGranted(PermissionNames.Pages_ParkingAreas))
                {
                    <a href="javascript:;" data-bs-toggle="modal" data-bs-target="#ParkingAreaCreateModal" class="btn bg-blue float-sm-right">
                        <i class="fa fa-plus-square"></i> @L("Create")
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                @await Html.PartialAsync("~/Views/ParkingArea/Index.AdvancedSearch.cshtml")
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="ParkingAreaTable" class="table table-striped table-bordered table-hover w-100">
                        <thead>
                            <tr>
                                <th></th>
                                <th>@L("ParkingCode")</th>
                                <th>@L("Name")</th>
                                <th>@L("VehicleType")</th>
                                <th>@L("Capacity")</th>
                                <th>@L("CurrentOccupancy")</th>
                                <th>@L("ParkingMode")</th>
                                <th>@L("Location")</th>
                                <th>@L("Status")</th>   
                                <th style="width: 200px">@L("Actions")</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("~/Views/ParkingArea/_CreateModal.cshtml")

<div class="modal fade" id="ParkingAreaEditModal" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content"></div>
    </div>
</div>

<div class="modal fade" id="ParkingAreaStatusModal" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <form id="ParkingAreaStatusForm">
                <input type="hidden" name="Id" id="ParkingAreaStatus_Id" />
                <div class="modal-header">
                    <h5 class="modal-title">@L("ChangeStatus")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">@L("ParkingArea"): <span id="ParkingAreaStatus_Name" class="text-primary"></span></label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L("Status")</label>
                        <select class="form-control" name="Status" id="ParkingAreaStatus_Select">
                            <option value="@((int)ParkingAreaStatus.Active)">@L("Active")</option>
                            <option value="@((int)ParkingAreaStatus.Inactive)">@L("Inactive")</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L("Cancel")</button>
                    <button type="submit" class="btn btn-primary">@L("Save")</button>
                </div>
            </form>
        </div>
    </div>
</div>
