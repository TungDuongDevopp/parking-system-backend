
@using ParkingSystem.Entities.Enums

<form id="QuotationSearchForm" class="form-horizontal">
    <div class="row g-2 align-items-center">

        <!-- Vehicle Type -->
        <div class="col-md-2">
            <select name="VehicleType" class="form-control vehicle-type-filter">
                <option value="">@L("All") @L("Type")</option>
                <option value="@((int)VehicleType.Bicycle)">@L("Bicycle")</option>
                <option value="@((int)VehicleType.ElectricBicycle)">@L("ElectricBicycle")</option>
                <option value="@((int)VehicleType.Motorcycle)">@L("Motorcycle")</option>
                <option value="@((int)VehicleType.ElectricMotorcycle)">@L("ElectricMotorcycle")</option>
                <option value="@((int)VehicleType.Car)">@L("Car")</option>
            </select>
        </div>

        <!-- Duration Unit -->
        <div class="col-md-2">
            <select name="DurationUnit" class="form-control duration-unit-filter">
                <option value="">@L("All") @L("Unit")</option>
                <option value="@((int)DurationUnit.Hour)">@L("Hour")</option>
                <option value="@((int)DurationUnit.Day)">@L("Day")</option>
                <option value="@((int)DurationUnit.Week)">@L("Week")</option>
                <option value="@((int)DurationUnit.Month)">@L("Month")</option>
                <option value="@((int)DurationUnit.Year)">@L("Year")</option>
            </select>
        </div>

        <!-- Duration -->
        <div class="col-md-2">
            <input type="number"
                   name="Duration"
                   class="form-control"
                   min="1"
                   placeholder="@L("Duration")" />
        </div>

        <!-- Min Price -->
        <div class="col-md-2">
            <input type="number"
                   name="MinPrice"
                   class="form-control"
                   min="1"
                   placeholder="@L("MinPrice")" />
        </div>

        <!-- Max Price -->
        <div class="col-md-2">
            <input type="number"
                   name="MaxPrice"
                   class="form-control"
                   min="1"
                   placeholder="@L("MaxPrice")" />
        </div>

        <!-- Filter -->
        <div class="col-md-1">
            <button type="button"
                    class="btn btn-primary w-100 btn-search"
                    title="@L("Filter")">
                <i class="fas fa-filter"></i>
            </button>
        </div>

        <!-- Clear -->
        <div class="col-md-1">
            <button type="button"
                    class="btn btn-outline-secondary w-100 btn-clear-search"
                    title="@L("Clear")">
                <i class="fas fa-undo"></i>
            </button>
        </div>

    </div>
</form>

