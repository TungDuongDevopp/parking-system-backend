@using ParkingSystem.Web.Models.Staff
@using ParkingSystem.Web.Models.Common.Modals
@model StaffListViewModel

<div class="modal fade" id="StaffCreateModal" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form name="staffCreateForm" role="form" class="form-horizontal">
                @await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel(L("CreateNewStaff")))
                <div class="modal-body">
                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("Account") (@L("User"))</label>
                        <div class="col-md-9">
                            @if (Model.AvailableUsers != null && Model.AvailableUsers.Any())
                            {
                                <select class="form-control" name="UserId" id="StaffCreate_UserId">
                                    <option value="">-- @L("SelectUser") --</option>
                                    @foreach (var user in Model.AvailableUsers)
                                    {
                                        <option value="@user.Id"
                                                data-name="@user.FullName"
                                                data-email="@user.EmailAddress"
                                                data-phone="@user.PhoneNumber">
                                            @user.UserName - @user.FullName (@user.EmailAddress)
                                        </option>
                                    }
                                </select>
                                <small class="form-text text-muted">@L("SelectUserWithStaffRoleInfo")</small>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    <i class="fas fa-exclamation-triangle me-1"></i>
                                    @L("NoAvailableStaffUserWarning")
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("Name")</label>
                        <div class="col-md-9">
                            <input type="text" class="form-control" name="Name" id="StaffCreate_Name" maxlength="100" placeholder="@L("Name")">
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("PhoneNumber")</label>
                        <div class="col-md-9">
                            <input type="text" class="form-control" name="PhoneNumber" id="StaffCreate_Phone" maxlength="20" placeholder="@L("PhoneNumber")">
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("EmailAddress")</label>
                        <div class="col-md-9">
                            <input type="email" class="form-control" name="Email" id="StaffCreate_Email" maxlength="255" placeholder="@L("EmailAddress")">
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("Gender")</label>
                        <div class="col-md-9">
                            <select class="form-control" name="Gender">
                                <option value="">-- @L("SelectGender") --</option>
                                <option value="true">@L("Male")</option>
                                <option value="false">@L("Female")</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("DateOfBirth")</label>
                        <div class="col-md-9">
                            <input type="date" class="form-control" name="DateOfBirth" max="@DateTime.Today.ToString("yyyy-MM-dd")">
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("HiredDate")</label>
                        <div class="col-md-9">
                            <input type="date" class="form-control" name="HiredDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")">
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("Address")</label>
                        <div class="col-md-9">
                            <textarea class="form-control" name="Address" rows="2" maxlength="1023" placeholder="@L("Address")"></textarea>
                        </div>
                    </div>
                </div>
                @await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
            </form>
        </div>
    </div>
</div>
