@using ParkingSystem.Web.Startup
@using ParkingSystem.Web.Models.Staff
@using ParkingSystem.Entities.Enums
@using ParkingSystem.Authorization
@model StaffListViewModel
@{
    ViewBag.Title = L("Staffs");
    ViewBag.CurrentPageName = PageNames.Staffs;
}
@section scripts
{
    <script src="~/view-resources/Views/Staff/Index.js" asp-append-version="true"></script>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>@L("Staffs")</h1>
            </div>
            <div class="col-sm-6">
                @if (IsGranted(PermissionNames.Pages_Staffs_Manager))
                {
                    <a href="javascript:;" data-bs-toggle="modal" data-bs-target="#StaffCreateModal" class="btn bg-blue float-sm-right">
                        <i class="fa fa-plus-square"></i> @L("Create")
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                @await Html.PartialAsync("~/Views/Staff/Index.AdvancedSearch.cshtml")
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="StaffTable" class="table table-striped table-bordered table-hover w-100">
                        <thead>
                            <tr>
                                <th></th>
                                <th>@L("Name")</th>
                                <th>@L("PhoneNumber")</th>
                                <th>@L("EmailAddress")</th>
                                <th>@L("Gender")</th>
                                <th>@L("DateOfBirth")</th>
                                <th>@L("HiredDate")</th>
                                <th>@L("Status")</th>
                                <th style="width: 170px">@L("Actions")</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("~/Views/Staff/_CreateModal.cshtml", Model)

<div class="modal fade" id="StaffEditModal" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content"></div>
    </div>
</div>

<div class="modal fade" id="StaffStatusModal" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <form id="StaffStatusForm">
                <input type="hidden" name="Id" id="StaffStatus_Id" />
                <div class="modal-header">
                    <h5 class="modal-title">@L("ChangeStatus")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">@L("Staff"): <span id="StaffStatus_Name" class="text-primary"></span></label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L("Status")</label>
                        <select class="form-control" name="Status" id="StaffStatus_Select">
                            <option value="@((int)StaffStatus.Active)">@L("Active")</option>
                            <option value="@((int)StaffStatus.Inactive)">@L("Inactive")</option>
                            <option value="@((int)StaffStatus.Suspended)">@L("Suspended")</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L("Cancel")</button>
                    <button type="submit" class="btn btn-primary">@L("Save")</button>
                </div>
            </form>
        </div>
    </div>
</div>
