@using ParkingSystem.Entities.Enums
@using ParkingSystem.Web.Models.Reservation
@model ReservationListViewModel
<form id="ReservationSearchForm" class="form-horizontal">

    <div class="row g-2 mb-2">
        <!-- Top row: main filters -->
        <div class="col-6 col-md-3">
            <select name="Status" class="form-control subscription-status-filter" title="@L("Status")">
                <option value="">@L("All") @L("Status")</option>
                <option value="@((int)ReservationStatus.Reserved)">@L("Reserved")</option>
                <option value="@((int)ReservationStatus.Completed)">@L("Completed")</option>
                <option value="@((int)ReservationStatus.Expired)">@L("Expired")</option>
                <option value="@((int)ReservationStatus.Invalid)">@L("Invalid")</option>
                <option value="@((int)ReservationStatus.Cancelled)">@L("Cancelled")</option>
            </select>
        </div>

        <div class="col-6 col-md-3">
            <select name="CustomerId" class="form-control reservation-customer-filter" title="@L("Customer")">
                <option value="">@L("All") @L("Customers")</option>
                @if (Model?.Customers != null)
                {
                    foreach (var customer in Model.Customers)
                    {
                        <option value="@customer.Id">@customer.DisplayText</option>
                    }
                }
            </select>
        </div>

        <div class="col-6 col-md-3">
            <select name="ParkingAreaId" class="form-control reservation-parkingArea-filter" title="@L("Areas")">
                <option value="">@L("All") @L("Areas")</option>
                @if (Model?.ParkingAreas != null)
                {
                    foreach (var parkingArea in Model.ParkingAreas)
                    {
                        <option value="@parkingArea.Id">@parkingArea.DisplayText</option>
                    }
                }
            </select>
        </div>

        <div class="col-6 col-md-3">
            <select name="ParkingSpotId" class="form-control reservation-parkingSpot-filter" title="@L("Spots")">
                <option value="">@L("All") @L("Spots")</option>
                @if (Model?.ParkingSpots != null)
                {
                    foreach (var parkingSpot in Model.ParkingSpots)
                    {
                        <option value="@parkingSpot.Id">@parkingSpot.DisplayText</option>
                    }
                }

            </select>
        </div>
    </div>

    <div class="row g-2 align-items-end">
        <!-- Bottom row: date filters + actions -->
        <div class="col-6 col-md-3">
            <label class="visually-hidden" for="ReservedAt">@L("ReservedAt")</label>
            <input type="date"
                   id="ReservedAt"
                   name="ReservedAt"
                   class="form-control"
                   placeholder="@L("ReservedAt")"
                   title="@L("ReservedAt")" />
        </div>

        <div class="col-6 col-md-3">
            <label class="visually-hidden" for="EndTime">@L("EndTime")</label>
            <input type="date"
                   id="EndTime"
                   name="EndTime"
                   class="form-control"
                   placeholder="@L("EndTime")"
                   title="@L("EndTime")" />
        </div>

        <div class="col-6 col-md-3">
            <button type="button"
                    class="btn btn-primary w-100 btn-search"
                    title="@L("Filter")">
                <i class="fas fa-filter"></i>
                <span class="d-none d-md-inline"> @L("Filter")</span>
            </button>
        </div>

        <div class="col-6 col-md-3">
            <button type="button"
                    class="btn btn-outline-secondary w-100 btn-clear-search"
                    title="@L("Clear")">
                <i class="fas fa-undo"></i>
                <span class="d-none d-md-inline"> @L("Clear")</span>
            </button>
        </div>
    </div>

</form>

