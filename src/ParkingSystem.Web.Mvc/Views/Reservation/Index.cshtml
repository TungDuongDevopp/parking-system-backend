@using ParkingSystem.Web.Startup

@{
    ViewBag.Title = L("Reservations");
    ViewBag.CurrentPageName = PageNames.Reservations;
}
@section scripts
{
    <script src="~/view-resources/Views/Reservation/Index.js" asp-append-version="true"></script>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>@L("Reservations")</h1>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                @await Html.PartialAsync("~/Views/Reservation/Index.AdvancedSearch.cshtml")
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="ReservationTable" class="table table-striped table-bordered table-hover w-100">
                        <thead>
                            <tr>
                                <th></th>
                                <th>@L("CustomerName")</th>
                                <th>@L("ParkingAreaCode")</th>
                                <th>@L("ParkingAreaName")</th>
                                <th>@L("SpotCode")</th>
                                <th>@L("ReservedAt")</th>
                                <th>@L("EndTime")</th>
                                <th>@L("Status")</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>



