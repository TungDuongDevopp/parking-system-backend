<form id="CustomerSearchForm" class="form-horizontal">
    <div class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" name="Keyword" class="form-control txt-search" placeholder="@L("SearchWithThreeDot")" />
                <button type="button" class="btn bg-blue btn-search" title="@L("Search")">
                    <span class="fas fa-search" aria-hidden="true"></span>
                </button>
            </div>
        </div>
        <div class="col-md-3 d-flex gap-1">
            <button type="button" class="btn btn-primary btn-search flex-grow-1" title="@L("Filter")">
                <i class="fas fa-filter"></i> @L("Filter")
            </button>
            <button type="button" class="btn btn-outline-secondary btn-clear-search" title="@L("Clear")">
                <i class="fas fa-undo"></i>
            </button>
        </div>
    </div>
</form>
