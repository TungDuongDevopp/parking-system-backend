@using ParkingSystem.Web.Models.Common.Modals
@using ParkingSystem.Web.Models.Customer
@model EditCustomerViewModel
@{
    Layout = null;
}
@await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel(L("EditCustomer")))
<form name="customerEditForm" role="form" class="form-horizontal">
    <input type="hidden" name="Id" value="@Model.Customer.Id" />
    <div class="modal-body">
        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">@L("Name")</label>
            <div class="col-md-9">
                <input type="text" class="form-control" name="Name" value="@Model.Customer.Name" maxlength="100">
            </div>
        </div>
        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">@L("PhoneNumber")</label>
            <div class="col-md-9">
                <input type="text" class="form-control" name="PhoneNumber" value="@Model.Customer.PhoneNumber" maxlength="20">
            </div>
        </div>
        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">@L("EmailAddress")</label>
            <div class="col-md-9">
                <input type="email" class="form-control" name="Email" value="@Model.Customer.Email" maxlength="255">
            </div>
        </div>
    </div>
    @await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
</form>
<script src="~/view-resources/Views/Customer/_EditModal.js" asp-append-version="true"></script>
