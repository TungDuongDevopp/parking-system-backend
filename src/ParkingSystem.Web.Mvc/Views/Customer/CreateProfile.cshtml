@using ParkingSystem.Web.Startup

@{
    ViewBag.Title = L("CreateNewCustomer");
    ViewBag.CurrentPageName = PageNames.CustomerProfile;
}
@section scripts
{
    <script src="~/view-resources/Views/Customer/CreateProfile.js" asp-append-version="true"></script>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>
                    <i class="fas fa-user-plus mr-2 me-2 text-primary"></i>
                    @L("CreateNewCustomer")
                </h1>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-8 col-lg-6">

                <!-- Welcome notice -->
                <div class="alert alert-info d-flex align-items-center mb-3">
                    <i class="fas fa-info-circle fa-2x mr-3 me-3 text-info"></i>
                    <div>
                        <strong>Welcome!</strong>
                        <span>Please create your customer profile to start using parking services.</span>
                    </div>
                </div>

                <div class="card card-primary card-outline shadow-sm">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-id-card mr-1 me-1"></i>
                            @L("CustomerProfile")
                        </h3>
                    </div>
                    <form id="CustomerCreateProfileForm" role="form" class="form-horizontal">
                        <div class="card-body">
                            <div class="form-group row mb-3">
                                <label class="col-sm-3 col-form-label">@L("Name") <span class="text-danger">*</span></label>
                                <div class="col-sm-9">
                                    <input type="text" class="form-control" name="Name" maxlength="100" required placeholder="@L("Name")">
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                <label class="col-sm-3 col-form-label">@L("PhoneNumber") <span class="text-danger">*</span></label>
                                <div class="col-sm-9">
                                    <input type="text" class="form-control" name="PhoneNumber" maxlength="20" required placeholder="@L("PhoneNumber")">
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                <label class="col-sm-3 col-form-label">@L("EmailAddress")</label>
                                <div class="col-sm-9">
                                    <input type="email" class="form-control" name="Email" maxlength="255" placeholder="@L("EmailAddress")">
                                </div>
                            </div>
                        </div>
                        <div class="card-footer d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary save-button">
                                <i class="fas fa-save mr-1 me-1"></i> @L("Save")
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</section>
