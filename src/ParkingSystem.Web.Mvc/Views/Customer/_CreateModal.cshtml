@using ParkingSystem.Web.Models.Common.Modals

<div class="modal fade" id="CustomerCreateModal" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form name="customerCreateForm" role="form" class="form-horizontal">
                @await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel(L("CreateNewCustomer")))
                <div class="modal-body">
                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("Name")</label>
                        <div class="col-md-9">
                            <input type="text" class="form-control" name="Name" maxlength="100" placeholder="@L("Name")">
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("PhoneNumber")</label>
                        <div class="col-md-9">
                            <input type="text" class="form-control" name="PhoneNumber" maxlength="20" placeholder="@L("PhoneNumber")">
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">@L("EmailAddress")</label>
                        <div class="col-md-9">
                            <input type="email" class="form-control" name="Email" maxlength="255" placeholder="@L("EmailAddress")">
                        </div>
                    </div>
                </div>
                @await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
            </form>
        </div>
    </div>
</div>
